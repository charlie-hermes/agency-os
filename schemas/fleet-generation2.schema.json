        "brand_id": {
          "$ref": "#/$defs/BrandId"
        },
        "module": {
          "enum": [
            "content_engine",
            "brand_twin",
            "ai_market_observatory",
            "brand_agent",
            "controlled_actions",
            "client_portal",
            "measurement",
            "agentic_commerce"
          ]
        },
        "limits": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
