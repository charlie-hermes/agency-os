{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-os.invalid/schemas/fleet-generation2.schema.json",
  "title": "Fleet Generation 2 foundational records",
  "description": "Brand-scoped contracts for tenancy, the Living Brand Twin, customer missions, observation, findings, remediation, experiments, and outcomes.",
  "$defs": {
    "Checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "EvidenceReference": {
      "type": "object",
      "required": [
        "source_id",
        "source_version",
        "source_checksum"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "integer",
          "minimum": 1
        },
        "source_checksum": {
          "$ref": "#/$defs/Checksum"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "BrandTenant": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_type",
        "tenant_id",
        "brand_id",
        "paperclip_company_id",
        "company_name",
        "status",
        "created_by",
        "created_at",
        "content_checksum"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "artifact_type": {
          "const": "brand_tenant"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^tenant_"
        },
        "brand_id": {
          "$ref": "#/$defs/BrandId"
        },
        "paperclip_company_id": {
          "type": "string",
          "format": "uuid"
        },
        "company_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "active"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_checksum": {
          "$ref": "#/$defs/Checksum"
        }
      },
      "additionalProperties": false
    },
    "PortalHostnameBinding": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_type",
        "binding_id",
        "brand_id",
        "brand_slug",
        "hostname",
        "base_domain",
        "status",
        "created_by",
        "created_at",
        "content_checksum"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "artifact_type": {
          "const": "portal_hostname_binding"
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "brand_id": {
          "$ref": "#/$defs/BrandId"
        },
        "brand_slug": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.madebyfleet\\.com$"
        },
        "base_domain": {
          "const": "madebyfleet.com"
        },
        "status": {
          "const": "active"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_checksum": {
          "$ref": "#/$defs/Checksum"
        }
      },
      "additionalProperties": false
    },
