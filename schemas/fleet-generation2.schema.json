        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_checksum": {
          "$ref": "#/$defs/Checksum"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "supersedes_entitlement_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
