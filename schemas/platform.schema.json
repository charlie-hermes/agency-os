{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-os.invalid/schemas/platform.schema.json",
  "title": "Agency OS Gate 5 platform records",
  "$defs": {
    "PaperclipTask": {
      "type": "object",
      "required": [
        "artifact_type",
        "paperclip_issue_id",
        "brand_id",
        "campaign_id",
        "version",
        "status",
        "dependencies",
        "acceptance_criteria",
        "approval_required",
        "budget",
        "completion_evidence_refs",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "paperclip_task"},
        "paperclip_issue_id": {"type": "string", "minLength": 1},
        "brand_id": {"type": "string", "pattern": "^brand_"},
        "campaign_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "status": {
          "enum": ["planned", "ready", "in_progress", "blocked", "done", "cancelled"]
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "approval_required": {"type": "boolean"},
        "budget": {
          "type": "object",
          "required": ["currency", "limit_minor", "spent_minor"],
          "properties": {
            "currency": {"type": "string", "minLength": 3},
            "limit_minor": {"type": "integer", "minimum": 0},
            "spent_minor": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "completion_evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "ApproverPolicy": {
      "type": "object",
      "required": [
        "artifact_type",
        "policy_id",
        "brand_id",
        "revision",
        "previous_policy_checksum",
        "permitted_approver_ids",
        "issued_by",
        "effective_at",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "approver_policy"},
        "policy_id": {"type": "string", "minLength": 1},
        "brand_id": {"type": "string", "pattern": "^brand_"},
        "revision": {"type": "integer", "minimum": 1},
        "previous_policy_checksum": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "permitted_approver_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "issued_by": {"type": "string", "minLength": 1},
        "effective_at": {"type": "string", "format": "date-time"},
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "PaperclipTaskApproval": {
      "type": "object",
      "required": [
        "artifact_type",
        "approval_id",
        "brand_id",
        "paperclip_issue_id",
        "task_checksum",
        "policy_id",
        "policy_revision",
        "policy_checksum",
        "decision",
        "approver_id",
        "authority_role",
        "decided_at",
        "expires_at",
        "approval_attestation",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "paperclip_task_approval"},
        "policy_id": {"type": "string", "minLength": 1},
        "policy_revision": {"type": "integer", "minimum": 1},
        "policy_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "decision": {"enum": ["APPROVED", "REJECTED"]},
        "authority_role": {"const": "human-approver"},
        "decided_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "approval_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_id", "algorithm", "signature"],
          "properties": {
            "authority_id": {"type": "string", "minLength": 1},
            "algorithm": {"const": "HMAC-SHA256"},
            "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "BuzzContextPacket": {
      "type": "object",
      "required": [
        "artifact_type",
        "context_id",
        "brand_id",
        "campaign_id",
        "paperclip_issue_id",
        "purpose",
        "decision_needed",
        "participants",
        "deadline",
        "exit_condition",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "buzz_context_packet"},
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "BuzzDecisionSummary": {
      "type": "object",
      "required": [
        "artifact_type",
        "decision_id",
        "brand_id",
        "paperclip_issue_id",
        "context_id",
        "context_checksum",
        "summary",
        "source_event_ids",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "buzz_decision_summary"},
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "WorkQueueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "work_item_id",
        "brand_id",
        "paperclip_issue_id",
        "paperclip_task_checksum",
        "work_kind",
        "worker_role",
        "payload",
        "max_attempts",
        "created_by",
        "created_at",
        "content_checksum"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_type": {"const": "work_queue_item"},
        "work_item_id": {"type": "string", "minLength": 1},
        "brand_id": {"type": "string", "pattern": "^brand_"},
        "paperclip_issue_id": {"type": "string", "minLength": 1},
        "paperclip_task_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "work_kind": {"enum": ["internal", "external_write"]},
        "worker_role": {
          "enum": [
            "technical-implementation-specialist",
            "platform-assurance-reviewer",
            "brand-brief-steward",
            "search-content-strategist",
            "content-producer",
            "search-answer-optimiser",
            "visual-creative-specialist",
            "editorial-integrity-qa",
            "social-amplifier",
            "publishing-operator",
            "growth-intelligence-analyst"
          ]
        },
        "payload": {"type": "object"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "EvidenceRecord": {
      "type": "object",
      "required": [
        "artifact_type",
        "evidence_id",
        "brand_id",
        "paperclip_issue_id",
        "source_ref",
        "source_class",
        "retrieved_at",
        "claim",
        "extract",
        "confidence",
        "created_by",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "evidence_record"},
        "brand_id": {"type": "string", "pattern": "^brand_"},
        "source_class": {"enum": ["primary", "first_party", "internal_test"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
