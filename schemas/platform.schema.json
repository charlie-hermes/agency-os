{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agency-os.invalid/schemas/platform.schema.json",
  "title": "Agency OS Gate 5 platform records",
  "$defs": {
    "PaperclipTask": {
      "type": "object",
      "required": [
        "artifact_type",
        "paperclip_issue_id",
        "brand_id",
        "campaign_id",
        "version",
        "status",
        "dependencies",
        "acceptance_criteria",
        "approval_required",
        "budget",
        "completion_evidence_refs",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "paperclip_task"},
        "paperclip_issue_id": {"type": "string", "minLength": 1},
        "brand_id": {"type": "string", "pattern": "^brand_"},
        "campaign_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "status": {
          "enum": ["planned", "ready", "in_progress", "blocked", "done", "cancelled"]
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "approval_required": {"type": "boolean"},
        "budget": {
          "type": "object",
          "required": ["currency", "limit_minor", "spent_minor"],
          "properties": {
            "currency": {"type": "string", "minLength": 3},
            "limit_minor": {"type": "integer", "minimum": 0},
            "spent_minor": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "completion_evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "PaperclipTaskApproval": {
      "type": "object",
      "required": [
        "artifact_type",
        "approval_id",
        "brand_id",
        "paperclip_issue_id",
        "task_checksum",
        "decision",
        "approver_id",
        "expires_at",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "paperclip_task_approval"},
        "decision": {"enum": ["APPROVED", "REJECTED"]},
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "BuzzContextPacket": {
      "type": "object",
      "required": [
        "artifact_type",
        "context_id",
        "brand_id",
        "campaign_id",
        "paperclip_issue_id",
        "purpose",
        "decision_needed",
        "participants",
        "deadline",
        "exit_condition",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "buzz_context_packet"},
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "BuzzDecisionSummary": {
      "type": "object",
      "required": [
        "artifact_type",
        "decision_id",
        "brand_id",
        "paperclip_issue_id",
        "context_id",
        "context_checksum",
        "summary",
        "source_event_ids",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "buzz_decision_summary"},
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "EvidenceRecord": {
      "type": "object",
      "required": [
        "artifact_type",
        "evidence_id",
        "brand_id",
        "paperclip_issue_id",
        "source_ref",
        "source_class",
        "retrieved_at",
        "claim",
        "extract",
        "confidence",
        "created_by",
        "content_checksum"
      ],
      "properties": {
        "artifact_type": {"const": "evidence_record"},
        "brand_id": {"type": "string", "pattern": "^brand_"},
        "source_class": {"enum": ["primary", "first_party", "internal_test"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
